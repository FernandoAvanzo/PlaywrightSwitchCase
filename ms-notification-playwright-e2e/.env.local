# Ambiente de execução Playwright
TEST_ENV=local
MS_NOTIFICATION_BASE_URL=http://localhost:18001/notification/v1
MOCK_BASE_URL=http://localhost:18089
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Aplicação alvo no Docker Compose local
# Ajuste para o caminho onde você baixou/clonou a pasta ms-notification do Google Drive.
MS_NOTIFICATION_SOURCE_DIR=/home/fernandoavanzo/Projects/ultragaz/ms-notification
MS_NOTIFICATION_PORT=18001
MS_NOTIFICATION_CONTAINER_PORT=8080
SPRING_PROFILES_ACTIVE=local
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# Banco local
MYSQL_DATABASE=notification
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=notification
MYSQL_PASSWORD=notification

# URLs dos mocks externos expostas para a aplicação alvo dentro da rede Docker
SMS_PROVIDER_BASE_URL=http://wiremock:8080/sms-provider
WHATSAPP_PROVIDER_BASE_URL=http://wiremock:8080/whatsapp-provider
BLIP_PROVIDER_BASE_URL=http://wiremock:8080
INFOBIP_PROVIDER_BASE_URL=http://wiremock:8080/infobip
SHORTENER_BASE_URL=http://wiremock:8080/shortener
FIREBASE_DYNAMIC_LINKS_BASE_URL=http://wiremock:8080/firebase

# Filas SQS locais
SQS_SMS_RETRY_QUEUE=ms-notification-sms-retry
SQS_SMS_HOSPITAL_QUEUE=ms-notification-sms-hospital
SQS_WHATSAPP_RETRY_QUEUE=ms-notification-whatsapp-retry
SQS_WHATSAPP_HOSPITAL_QUEUE=ms-notification-whatsapp-hospital
SQS_ROUTEASY_HOSPITAL_QUEUE=ms-notification-routeasy-hospital
SQS_NOTIFICATION_RETRY_QUEUE=ms-notification-notification-retry

# Credenciais sintéticas para alias
CREDENTIALS_ALIAS_DEFAULT=default
CREDENTIALS_ALIAS_VOUCHERS=vouchers
SMS_DEFAULT_USERNAME=local-sms-user
SMS_DEFAULT_PASSWORD=local-sms-pass
WHATSAPP_DEFAULT_USERNAME=local-whatsapp-user
WHATSAPP_DEFAULT_PASSWORD=local-whatsapp-pass
WHATSAPP_CONTRACT_ID=local-blip-contract
WHATSAPP_API_KEY=local-blip-api-key
WHATSAPP_TEMPLATE_NAMESPACE=local-template-namespace
WHATSAPP_TEMPLATE_NAME=vale_gas_codigo_venda
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
