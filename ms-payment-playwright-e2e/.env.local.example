# Playwright target
TEST_ENV=local
MS_PAYMENT_BASE_URL=http://localhost:8001/payment/v1
WIREMOCK_URL=http://localhost:8089
WEBHOOK_MOCK_URL=http://localhost:8090
MALGA_MERCHANT_ID=merchant-local
POLL_TIMEOUT_MS=30000
ALLOW_DESTRUCTIVE_TESTS=false

# Docker Compose dependencies
MYSQL_PORT=3307
MYSQL_DATABASE=payment
MYSQL_USER=payment
MYSQL_PASSWORD=payment
MYSQL_ROOT_PASSWORD=root
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack SSM bootstrap for ms-payment Malga credentials
MALGA_API_KEY_PARAMETER=/ms-payment/local/malga/api-key
MALGA_CLIENT_ID_PARAMETER=/ms-payment/local/malga/client-id
MALGA_API_KEY=test-api-key
MALGA_CLIENT_ID=test-client-id

# Path to the target ms-payment repository when using `npm run infra:up:app`.
# Keep the default when repositories are side-by-side:
MS_PAYMENT_PROJECT_DIR=/home/fernandoavanzo/Projects/ultragaz//ms-payment
