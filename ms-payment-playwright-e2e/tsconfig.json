{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "baseUrl": ".",
    "paths": {"@/*": ["src/*"]},
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "src/**/*.ts", "scripts/**/*.ts"]
}
