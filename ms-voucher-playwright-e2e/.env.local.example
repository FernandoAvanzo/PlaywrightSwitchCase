# Ambiente da suíte Playwright
TEST_ENV=local
BASE_URL=http://localhost:8001/voucher/v1
ACCEPT_LANGUAGE=pt_BR
ALLOW_MUTATION=true
ENABLE_MUTATING_E2E=false

# Stubs locais
WIREMOCK_NOTIFICATION_ADMIN_URL=http://localhost:18081/__admin
WIREMOCK_SOA_ADMIN_URL=http://localhost:18082/__admin
LOCALSTACK_ENDPOINT=http://localhost:4566

# Docker Compose local
# Se alterar portas publicadas aqui, mantenha BASE_URL/WIREMOCK_*/LOCALSTACK_ENDPOINT/MYSQL_PORT coerentes.
COMPOSE_PROJECT_NAME=ms-voucher-playwright-local
MS_VOUCHER_PORT=8001
MYSQL_PORT=3306
REDIS_PORT=6379
LOCALSTACK_PORT=4566
NOTIFICATION_WIREMOCK_PORT=18081
SOA_WIREMOCK_PORT=18082
ORACLE_PORT=1521

# source local
MS_VOUCHER_PROJECT_DIR=../../../ms-voucher

# Banco local usado para verificações opcionais
MYSQL_HOST=localhost
MYSQL_DATABASE=ms_voucher
MYSQL_USER=ms_voucher
MYSQL_PASSWORD=ms_voucher

# Massa de teste: preencher com dados válidos da base local/HML
CUSTOMER_ID=100000
CUSTOMER_SITE_ID=200000
CNPJ_DISTRIBUIDOR=03282579000110
PRODUCT_CODE=0110035
PRODUCT_CODE_BARCODE=
PHONE_DDD=11
PHONE_NUMBER=999999999
NSU_VENDA=
AUTH_CODE=
FEPAS_EFFECTIVE_ID=

# Segurança dos testes mutantes
MUTATION_TARGET_ENV=local
REQUIRE_EXPLICIT_MUTATION=true
