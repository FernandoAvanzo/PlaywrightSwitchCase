# Copie para .env.ms-voucher-hml.local, preencha os segredos e aplique chmod 600.
# O launcher lê este arquivo diretamente; nenhum segredo é colocado na linha de comando.
MS_VOUCHER_PROJECT_DIR=../../ms-voucher
LOCAL_HML_STARTUP_TIMEOUT_MS=240000

server.port=8001
spring.datasource.primary.url=jdbc:mysql://HML_MYSQL_HOST/ms-voucher?sslMode=REQUIRED
spring.datasource.primary.username=<secret>
spring.datasource.primary.password=<secret>
spring.datasource.primary.maximum-pool-size=20
spring.datasource.secondary.wallet=wallet_UltragazHML
spring.datasource.secondary.tnsname=ugsistemashml_low
spring.datasource.secondary.username=<secret>
spring.datasource.secondary.password=<secret>
spring.datasource.secondary.maximum-pool-size=20
spring.datasource.secondary.max-life-time=300000
aws.voucher-soa.sqs=voucher-soa-out
transaction-integrations.strategy=soap
transaction-integrations.soap.endpoint=https://servicoshml.ultragaz.com.br/ws/in/Ebs/Evale/v6
transaction-integrations.soap.generated-classes-package=br.com.ultragaz.voucher.integration.client.soap.generated
transaction-integrations.soap.connection-timeout=30000
transaction-integrations.soap.read-timeout=30000
transaction-integrations.soap.username=<secret>
transaction-integrations.soap.password=<secret>
notification.endpoint=http://service-notification.default.svc.cluster.local:8001/notification/v1
notification.credentials-alias=vouchers
notification.queue.hospital=notification-hospital-out-sqs
auth.endpoint=https://api-sandbox.ultragaz.com.br/oauth/access-token
auth.client-id=<secret>
auth.client-secret=<secret>
jobs.generated-authorization-code.is-enabled=true
jobs.generated-authorization-code.minimum-codes-quantity=3000
jobs.generated-authorization-code.generate-codes-quantity=50000
voucher.max-sale-voucher-allowed=1000
cache.voucher.get-store=8
aws.voucher-store.bucket=ms-voucher-ultragaz-store-sheet-hml-us
aws.voucher-store.key=voucher-store/sheets
aws.voucher-store.download-expiration-hours=8
aws.voucher-store.default-file-name=DETALHESVALEGAS_
spring.redis.host=HML_REDIS_HOST
spring.redis.port=6379
aws.sell-voucher-sqs-msg=ms-voucher-ultragaz-hml-artifacts/sell-voucher-sqs-msg
aws.sqs.notify-distributor-voucher=notify-distributor-voucher-sqs
legacy.integration.rest.block-voucher-endpoint=https://api-sandbox.ultragaz.com.br/ebs/wrapper/v1/vale-gas/bloquear-lote
legacy.integration.rest.authentication.client_id=<secret>
legacy.integration.rest.authentication.client_secret=<secret>
jobs.expire-vouchers.is-enabled=false
jobs.start-voucher-validity.is-enabled=false
events-hub.baseUrl=https://event-receiver.sensedia.com/event-receiver/REPLACE_WITH_HML_PATH
events-hub.voucher-handler=voucher-events
events-hub.topics.transaction=transactions
events-hub.topics.sms-callback=sms-callbacks
aws.secret-name=svc-ms-voucher-hml
aws.region=us-east-1
aws.access-key=<secret>
aws.secret-key=<secret>
spring.redis.is-stand-alone=false
aws.access-key-ses=<secret>
aws.secret-key-ses=<secret>
aws.region-ses=us-east-1
event.listeners.sqs.integration-events.queue-name=voucher-events-buffer

# Não habilite no uso normal. Quando ausente, o launcher desativa Flyway, jobs e consumidores de eventos.
ALLOW_HML_BACKGROUND_WORKERS=
