TEST_ENV=prod
BASE_URL=https://api.example.com/voucher/v1
ACCEPT_LANGUAGE=pt-BR

# PROD deve rodar apenas smoke/read-only por padrão.
ALLOW_MUTATION=false
ENABLE_MUTATING_E2E=false
SETUP_CONTRACT=pricing-discount-limits
SETUP_ID=default
PRICING_TECHNICAL_CEILING=50.00
PRICING_MAX_ABSOLUTE_DISCOUNT=30.00
PRICING_MAX_PERCENTAGE_DISCOUNT=40.00
PRICING_ALLOW_LEGACY_CAMPAIGN_REPAIR=false
ENABLE_FEPAS_E2E=false
FEPAS_DISTRIBUTOR_DOCUMENT=

CUSTOMER_ID=
CUSTOMER_SITE_ID=
CNPJ_DISTRIBUIDOR=
PRODUCT_CODE=
PRODUCT_CODE_SECOND=
PRODUCT_CODE_BARCODE=
PHONE_DDD=
PHONE_NUMBER=
NSU_VENDA=
AUTH_CODE=
FEPAS_EFFECTIVE_ID=

# Mantidos vazios: a suíte bloqueia operações mutantes em PROD.
BATCH_CASE_ID_PREFIX=PW-422007
BATCH_VALIDATION_CHANNEL=APP
BATCH_CODE_RESALE=
BATCH_ADDRESS_VALIDATION=
BATCH_DOCUMENT_RESALE=
BATCH_USER_TYPE=CONSUMIDOR_FINAL
BATCH_PRODUCT_CODE=
BATCH_CONSUMER_DOCUMENT=
BATCH_CONSUMER_PHONE_NUMBER=
BATCH_DESTINATION_COMPANY=
BATCH_VOUCHER_INSUFFICIENT_STOCK=
BATCH_VOUCHER_SUCCESS=
BATCH_VOUCHER_MISSING_COORDINATES=
BATCH_VOUCHER_COORDINATE_PROPAGATION=
BATCH_VOUCHER_NOT_FOUND=
BATCH_MIXED_VOUCHER_SUCCESS=
BATCH_MIXED_VOUCHER_INSUFFICIENT_STOCK=
BATCH_WEBHOOK_URL=
BATCH_VOUCHER_WEBHOOK_INSUFFICIENT_STOCK=
BATCH_POLL_TIMEOUT_MS=120000
BATCH_POLL_INTERVAL_MS=2000

MUTATION_TARGET_ENV=prod
REQUIRE_EXPLICIT_MUTATION=true
