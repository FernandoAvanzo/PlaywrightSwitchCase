{
  "name": "ms-voucher-playwright-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright API E2E/BDD suite for ms-voucher with local Docker Compose infrastructure.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:local": "TEST_ENV=local playwright test --project=api-local",
    "test:local-hml": "TEST_ENV=local-hml playwright test --project=api-local-hml --grep @smoke",
    "test:local-hml:all-safe": "TEST_ENV=local-hml playwright test --project=api-local-hml",
    "test:hml": "TEST_ENV=hml playwright test --project=api-hml",
    "test:prod": "TEST_ENV=prod playwright test --project=api-prod --grep @smoke",
    "test:setup": "playwright test tests/setup",
    "test:pricing": "playwright test tests/pricing",
    "test:notification": "playwright test tests/notification",
    "test:batch": "playwright test tests/batch",
    "report": "playwright show-report",
    "infra:up": "docker compose --env-file .env.local -f docker/docker-compose.local.yml up -d --build --remove-orphans",
    "infra:down": "docker compose --env-file .env.local -f docker/docker-compose.local.yml down -v --remove-orphans",
    "infra:logs": "docker compose --env-file .env.local -f docker/docker-compose.local.yml logs -f mysql redis localstack ms-notification-wiremock soa-wiremock",
    "infra:logs:app": "docker compose --env-file .env.local -f docker/docker-compose.local.yml logs -f ms-voucher",
    "infra:ps": "docker compose --env-file .env.local -f docker/docker-compose.local.yml ps",
    "infra:config": "docker compose --env-file .env.local -f docker/docker-compose.local.yml config",
    "doctor:env": "tsx scripts/doctor-env.ts",
    "doctor:local-hml": "tsx scripts/doctor-local-hml.ts",
    "app:local-hml": "tsx scripts/run-ms-voucher-local-hml.ts",
    "e2e:local-hml": "tsx scripts/run-local-hml-e2e.ts --grep @smoke",
    "e2e:local-hml:all-safe": "tsx scripts/run-local-hml-e2e.ts",
    "seed:local": "tsx scripts/seed-local.ts",
    "lint": "tsc --noEmit",
    "infra:up:app": "docker compose --env-file .env.local -f docker/docker-compose.local.yml --profile app up -d --build --remove-orphans",
    "infra:up:all": "docker compose --env-file .env.local -f docker/docker-compose.local.yml --profile app --profile oracle up -d --build --remove-orphans"
  },
  "dependencies": {
    "dotenv": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
